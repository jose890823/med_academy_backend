# CONFIGURACION DEL ENTORNO DE TEST
NODE_ENV=test

# CONFIGURACION DE POSTGRESQL (base de datos separada)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uma_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# CONFIGURACION DEL SERVIDOR
PORT=3001
APP_URL=http://localhost:3001

# URLs DE LAS APLICACIONES FRONTEND
FRONTEND_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# CONFIGURACION DE AUTENTICACION
JWT_SECRET=test_jwt_secret_key_for_e2e_testing_only
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_for_e2e_testing_only
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=4
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3

# CONFIGURACION DE EMAIL (no enviar emails reales en tests)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=test@ultrasoundmedacademy.com

# CONFIGURACION DE ENCRIPTACION
ENCRYPTION_KEY=test_aes256_encryption_key_for_e2e!!

# CONFIGURACION DE REDIS (DB separada para tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# STRIPE (mock/test)
STRIPE_SECRET_KEY=sk_test_fake_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_fake_webhook_secret_for_testing

# SUPER ADMIN (se crea automaticamente al iniciar)
SUPER_ADMIN_EMAIL=admin@ultrasoundmedacademy.com
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=+19542474395
