# 🌍 ENVIRONMENT CONFIGURATION
NODE_ENV=development

# 🗄️ POSTGRESQL CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echomeddx
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# 🚀 SERVER CONFIGURATION
PORT=3001
APP_URL=http://localhost:3001

# 🌐 FRONTEND URLs
FRONTEND_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# 🔐 AUTHENTICATION CONFIGURATION
# JWT Access Token
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h

# JWT Refresh Token
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRATION=30d

# Bcrypt salt rounds
BCRYPT_ROUNDS=10

# OTP configuration
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3

# 📧 EMAIL CONFIGURATION (Gmail SMTP)
# Generate app password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@echomeddx.com

# 🔒 ENCRYPTION CONFIGURATION
# AES-256 encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key_here

# 🔴 REDIS CONFIGURATION (for Bull Queue - notifications)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 📱 SMS/WHATSAPP CONFIGURATION (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# 💳 STRIPE CONFIGURATION (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 🤖 OPENAI CONFIGURATION (AI Content Generation)
OPENAI_API_KEY=sk-your_openai_api_key

# 🔔 PUSH NOTIFICATIONS (Firebase Cloud Messaging - optional)
# FCM_API_KEY=your_fcm_api_key

# 👤 SUPER ADMIN (created automatically on startup)
SUPER_ADMIN_EMAIL=admin@echomeddx.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=+1234567890

# 📝 INSTRUCTIONS:
# 1. Copy this file and rename to .env
# 2. Adjust variables according to your configuration
# 3. NEVER upload the .env file to the repository
